{
  "name": "healthcheck",
  "version": "0.1.1",
  "description": "Healthcheck observatory monitoring monthly 17th cron execution across heartbeat repositories via OpenAPI 3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch-data": "node scripts/fetch-heartbeats.mjs",
    "build": "node scripts/fetch-heartbeats.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baotrivn/healthcheck.git"
  },
  "keywords": [
